// Mongoose schemas — generated by CodeFlow from DBML

// Skipped user_settings.user_id - users.id: a one-to-one where nothing says which side holds the key — make only one end the primary key, or mark the foreign-key column unique.

const mongoose = require('mongoose');
const { Schema } = mongoose;

const UsersSchema = new Schema({
  // _id is managed by MongoDB itself
  email: { type: String, required: true, unique: true },
  role: { type: String, default: 'member' },
  karma: { type: Number, default: 0 },
  active: { type: Boolean, default: true },
  created_at: { type: Date, default: Date.now },
}, { timestamps: true });

const Users = mongoose.model('Users', UsersSchema);

const ProfilesSchema = new Schema({
  // _id is managed by MongoDB itself
  user_id: { type: Schema.Types.ObjectId, ref: 'Users' },
  bio: { type: String, default: 'it\'s me' },
}, { timestamps: true });

const Profiles = mongoose.model('Profiles', ProfilesSchema);

const PassportsSchema = new Schema({
  // _id is managed by MongoDB itself
  owner_id: { type: Schema.Types.ObjectId, ref: 'Users', required: true },
  number: { type: String },
}, { timestamps: true });

const Passports = mongoose.model('Passports', PassportsSchema);

const ShopsSchema = new Schema({
  // _id is managed by MongoDB itself
  name: { type: String },
}, { timestamps: true });

const Shops = mongoose.model('Shops', ShopsSchema);

const OrdersSchema = new Schema({
  shop_id: { type: Schema.Types.ObjectId, ref: 'Shops', required: true },
  number: { type: Number, required: true },
  status: { type: String, default: 'pending' },
  placed_at: { type: Date, default: Date.now },
  code: { type: String }, // default gen_random_uuid() is a database expression
  total: { type: Number, default: 0.5 },
  slug: { type: String }, // default lower(md5(random()::text)) is a database expression
}, { timestamps: true });

const Orders = mongoose.model('Orders', OrdersSchema);

const OrderLinesSchema = new Schema({
  // _id is managed by MongoDB itself
  shop_id: { type: Number, required: true },
  order_number: { type: Number, required: true },
  quantity: { type: Number, default: 1 },
}, { timestamps: true });

const OrderLines = mongoose.model('OrderLines', OrderLinesSchema);

const UserSettingsSchema = new Schema({
  user_id: { type: Number, required: true },
  theme: { type: String, default: 'dark' },
}, { timestamps: true });

const UserSettings = mongoose.model('UserSettings', UserSettingsSchema);

module.exports = { Users, Profiles, Passports, Shops, Orders, OrderLines, UserSettings };
