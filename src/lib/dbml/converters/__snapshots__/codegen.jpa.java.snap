package com.example.model;

import jakarta.persistence.*;
import java.io.Serializable;
import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.util.List;
import java.util.UUID;

@Entity
@Table(name = "orders")
@IdClass(Orders.Key.class)
public class Orders implements Serializable {

    @Id
    @Column(name = "shop_id")
    private int shopId;

    @Id
    @Column(name = "number")
    private int number;

    @Column(name = "status")
    // default: 'pending'
    private String status;

    @Column(name = "placed_at")
    // default: now()
    private LocalDateTime placedAt;

    @Column(name = "code")
    // default: gen_random_uuid()
    private UUID code;

    @Column(name = "total")
    // default: 0.5
    private BigDecimal total;

    @Column(name = "slug")
    // default: lower(md5(random()::text))
    private String slug;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "shop_id", referencedColumnName = "id", insertable = false, updatable = false)
    private Shops shop;

    @OneToMany(mappedBy = "orders", cascade = CascadeType.ALL, orphanRemoval = true)
    private List<OrderLines> orderLinesList;


    /** The composite key, as `@IdClass` requires. Give it equals() and hashCode() over every field. */
    public static class Key implements Serializable {
        private int shopId;
        private int number;
    }

