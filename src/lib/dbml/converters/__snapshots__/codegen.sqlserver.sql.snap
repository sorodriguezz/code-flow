CREATE TABLE [users] (
  [id] INTEGER IDENTITY(1,1) NOT NULL PRIMARY KEY,
  [email] VARCHAR(255) NOT NULL UNIQUE,
  [role] VARCHAR DEFAULT 'member',
  [karma] INTEGER DEFAULT 0,
  [active] BIT DEFAULT 1,
  [created_at] DATETIME2 DEFAULT GETDATE()
);

CREATE TABLE [profiles] (
  [id] INTEGER IDENTITY(1,1) NOT NULL PRIMARY KEY,
  [user_id] INTEGER UNIQUE,
  [bio] NVARCHAR(MAX) DEFAULT 'it''s me'
);

CREATE TABLE [passports] (
  [id] INTEGER NOT NULL PRIMARY KEY,
  [owner_id] INTEGER NOT NULL UNIQUE,
  [number] VARCHAR(20)
);

CREATE TABLE [shops] (
  [id] INTEGER NOT NULL PRIMARY KEY,
  [name] VARCHAR
);

CREATE TABLE [orders] (
  [shop_id] INTEGER NOT NULL,
  [number] INTEGER NOT NULL,
  [status] NVARCHAR(255) CHECK ([status] IN ('pending', 'shipped')) DEFAULT 'pending',
  [placed_at] DATETIME2 DEFAULT GETDATE(),
  [code] UNIQUEIDENTIFIER DEFAULT NEWID(),
  [total] DECIMAL(10,2) DEFAULT 0.5,
  [slug] VARCHAR DEFAULT lower(md5(random()::text)),
  PRIMARY KEY ([shop_id], [number])
);

CREATE TABLE [order_lines] (
  [id] INTEGER IDENTITY(1,1) NOT NULL PRIMARY KEY,
  [shop_id] INTEGER NOT NULL,
  [order_number] INTEGER NOT NULL,
  [quantity] INTEGER DEFAULT 1
);

CREATE TABLE [user_settings] (
  [user_id] INTEGER NOT NULL PRIMARY KEY,
  [theme] VARCHAR DEFAULT 'dark'
);

ALTER TABLE [profiles]
  ADD CONSTRAINT [fk_profiles_user_id]
  FOREIGN KEY ([user_id]) REFERENCES [users] ([id]);

ALTER TABLE [passports]
  ADD CONSTRAINT [fk_passports_owner_id]
  FOREIGN KEY ([owner_id]) REFERENCES [users] ([id]);

ALTER TABLE [orders]
  ADD CONSTRAINT [fk_orders_shop_id]
  FOREIGN KEY ([shop_id]) REFERENCES [shops] ([id]);

ALTER TABLE [order_lines]
  ADD CONSTRAINT [fk_order_lines_shop_id_order_number]
  FOREIGN KEY ([shop_id], [order_number]) REFERENCES [orders] ([shop_id], [number]);
