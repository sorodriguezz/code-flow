// Drizzle ORM schema — generated by CodeFlow from DBML

// Skipped user_settings.user_id - users.id: a one-to-one where nothing says which side holds the key — make only one end the primary key, or mark the foreign-key column unique.

import { sql } from 'drizzle-orm';
import { boolean, foreignKey, integer, numeric, pgEnum, pgTable, primaryKey, serial, text, timestamp, uuid, varchar } from 'drizzle-orm/pg-core';

export const orderStatusEnum = pgEnum('order_status', ['pending', 'shipped']);

export const users = pgTable('users', {
  id: serial('id').primaryKey(),
  email: varchar('email', { length: 255 }).notNull().unique(),
  role: varchar('role').default('member'),
  karma: integer('karma').default(0),
  active: boolean('active').default(true),
  createdAt: timestamp('created_at').defaultNow(),
});

export const profiles = pgTable('profiles', {
  id: serial('id').primaryKey(),
  userId: integer('user_id').unique().references(() => users.id),
  bio: text('bio').default('it\'s me'),
});

export const passports = pgTable('passports', {
  id: integer('id').primaryKey(),
  ownerId: integer('owner_id').notNull().unique().references(() => users.id),
  number: varchar('number', { length: 20 }),
});

export const shops = pgTable('shops', {
  id: integer('id').primaryKey(),
  name: varchar('name'),
});

export const orders = pgTable('orders', {
  shopId: integer('shop_id').notNull().references(() => shops.id),
  number: integer('number').notNull(),
  status: orderStatusEnum('status').default('pending'),
  placedAt: timestamp('placed_at').defaultNow(),
  code: uuid('code').defaultRandom(),
  total: numeric('total', { precision: 10, scale: 2 }).default('0.5'),
  slug: varchar('slug').default(sql`lower(md5(random()::text))`),
}, (table) => [
  primaryKey({ columns: [table.shopId, table.number] }),
]);

export const orderLines = pgTable('order_lines', {
  id: serial('id').primaryKey(),
  shopId: integer('shop_id').notNull(),
  orderNumber: integer('order_number').notNull(),
  quantity: integer('quantity').default(1),
}, (table) => [
  foreignKey({
    columns: [table.shopId, table.orderNumber],
    foreignColumns: [orders.shopId, orders.number],
  }),
]);

export const userSettings = pgTable('user_settings', {
  userId: integer('user_id').primaryKey(),
  theme: varchar('theme').default('dark'),
});
