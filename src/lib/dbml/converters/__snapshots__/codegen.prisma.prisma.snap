// Prisma schema — generated by CodeFlow from DBML

// Skipped user_settings.user_id - users.id: a one-to-one where nothing says which side holds the key — make only one end the primary key, or mark the foreign-key column unique.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  pending
  shipped
}

model Users {
  id                     Int  @id @default(autoincrement())
  email                  String  @unique @db.VarChar(255)
  role                   String?  @default("member")
  karma                  Int?  @default(0)
  active                 Boolean?  @default(true)
  created_at             DateTime?  @default(now())

  profiles               Profiles?
  passports              Passports?

  @@map("users")
}

model Profiles {
  id                     Int  @id @default(autoincrement())
  user_id                Int?  @unique
  bio                    String?  @default("it's me") @db.Text

  user                   Users?  @relation(fields: [user_id], references: [id])

  @@map("profiles")
}

model Passports {
  id                     Int  @id
  owner_id               Int  @unique
  number                 String?  @db.VarChar(20)

  owner                  Users  @relation(fields: [owner_id], references: [id])

  @@map("passports")
}

model Shops {
  id                     Int  @id
  name                   String?

  orderss                Orders[]

  @@map("shops")
}

model Orders {
  shop_id                Int
  number                 Int
  status                 OrderStatus?  @default(pending)
  placed_at              DateTime?  @default(now())
  code                   String?  @default(dbgenerated("gen_random_uuid()"))
  total                  Decimal?  @default(0.5) @db.Decimal(10, 2)
  slug                   String?  @default(dbgenerated("lower(md5(random()::text))"))

  shop                   Shops  @relation(fields: [shop_id], references: [id])
  orderLiness            OrderLines[]

  @@id([shop_id, number])
  @@map("orders")
}

model OrderLines {
  id                     Int  @id @default(autoincrement())
  shop_id                Int
  order_number           Int
  quantity               Int?  @default(1)

  orders                 Orders  @relation(fields: [shop_id, order_number], references: [shop_id, number])

  @@map("order_lines")
}

model UserSettings {
  user_id                Int  @id
  theme                  String?  @default("dark")

  @@map("user_settings")
}
