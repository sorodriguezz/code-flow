{
  "id": "trello",
  "name": "Trello",
  "group": "appsProjects",
  "baseUrl": "https://api.trello.com/1",
  "auth": "query",
  "authHint": { "es": "Tu API key como usuario y tu token como contraseña, en una credencial Usuario y contraseña", "en": "Your API key as the user and your token as the password, in a User and password credential" },
  "authQuery": { "key": "{{user}}", "token": "{{secret}}" },
  "operations": [
    {
      "id": "createCard",
      "name": { "es": "Crear una tarjeta", "en": "Create a card" },
      "method": "POST",
      "path": "/cards",
      "fields": [
        { "name": "listId", "label": { "es": "Lista (id)", "en": "List (id)" }, "required": true },
        { "name": "name", "label": { "es": "Título", "en": "Title" }, "required": true },
        { "name": "desc", "label": { "es": "Descripción", "en": "Description" }, "multiline": true },
        { "name": "due", "label": { "es": "Vence (ISO 8601)", "en": "Due (ISO 8601)" }, "placeholder": "2026-10-10T12:00:00Z" },
        { "name": "pos", "label": { "es": "Posición (top o bottom)", "en": "Position (top or bottom)" }, "placeholder": "top" }
      ],
      "body": { "idList": "{{listId}}", "name": "{{name}}", "desc": "{{desc}}", "due": "{{due}}", "pos": "{{pos}}" }
    },
    {
      "id": "moveCard",
      "name": { "es": "Mover una tarjeta de lista", "en": "Move a card to a list" },
      "method": "PUT",
      "path": "/cards/{{cardId}}",
      "fields": [
        { "name": "cardId", "label": { "es": "Tarjeta (id)", "en": "Card (id)" }, "required": true },
        { "name": "listId", "label": { "es": "Lista destino (id)", "en": "Target list (id)" }, "required": true },
        { "name": "pos", "label": { "es": "Posición (top o bottom)", "en": "Position (top or bottom)" }, "placeholder": "top" }
      ],
      "body": { "idList": "{{listId}}", "pos": "{{pos}}" }
    },
    {
      "id": "commentCard",
      "name": { "es": "Comentar una tarjeta", "en": "Comment on a card" },
      "method": "POST",
      "path": "/cards/{{cardId}}/actions/comments",
      "query": { "text": "{{text}}" },
      "fields": [
        { "name": "cardId", "label": { "es": "Tarjeta (id)", "en": "Card (id)" }, "required": true },
        { "name": "text", "label": { "es": "Comentario", "en": "Comment" }, "multiline": true, "required": true }
      ]
    },
    {
      "id": "archiveCard",
      "name": { "es": "Archivar una tarjeta", "en": "Archive a card" },
      "method": "PUT",
      "path": "/cards/{{cardId}}",
      "fields": [{ "name": "cardId", "label": { "es": "Tarjeta (id)", "en": "Card (id)" }, "required": true }],
      "body": { "closed": true }
    },
    {
      "id": "listCards",
      "name": { "es": "Tarjetas de una lista", "en": "A list's cards" },
      "method": "GET",
      "path": "/lists/{{listId}}/cards",
      "fields": [{ "name": "listId", "label": { "es": "Lista (id)", "en": "List (id)" }, "required": true }]
    },
    {
      "id": "boardLists",
      "name": { "es": "Listas de un tablero", "en": "A board's lists" },
      "method": "GET",
      "path": "/boards/{{boardId}}/lists",
      "fields": [{ "name": "boardId", "label": { "es": "Tablero (id o shortLink)", "en": "Board (id or shortLink)" }, "required": true }]
    },
    {
      "id": "addCheckItem",
      "name": { "es": "Añadir un ítem a un checklist", "en": "Add an item to a checklist" },
      "method": "POST",
      "path": "/checklists/{{checklistId}}/checkItems",
      "fields": [
        { "name": "checklistId", "label": { "es": "Checklist (id)", "en": "Checklist (id)" }, "required": true },
        { "name": "name", "label": { "es": "Ítem", "en": "Item" }, "required": true }
      ],
      "body": { "name": "{{name}}" }
    }
  ]
}
