{
  "id": "jira",
  "name": "Jira",
  "group": "appsProjects",
  "baseUrl": "https://{{site}}.atlassian.net/rest/api/3",
  "auth": "basic",
  "authHint": {
    "es": "Tu correo y un token de API de Atlassian como credencial Usuario y contraseña",
    "en": "Your email and an Atlassian API token as a User and password credential"
  },
  "tokenUrl": "https://id.atlassian.com/manage-profile/security/api-tokens",
  "userLabel": {
    "es": "Correo de Atlassian",
    "en": "Atlassian email"
  },
  "secretLabel": {
    "es": "Token de API",
    "en": "API token"
  },
  "test": {
    "path": "/myself",
    "label": "{{displayName}} · {{emailAddress}}"
  },
  "siteField": {
    "name": "site",
    "label": {
      "es": "Sitio (tu-equipo en tu-equipo.atlassian.net)",
      "en": "Site (your-team in your-team.atlassian.net)"
    },
    "placeholder": "acme",
    "required": true
  },
  "errorField": "errorMessages",
  "operations": [
    {
      "id": "createIssue",
      "name": {
        "es": "Crear un issue",
        "en": "Create an issue"
      },
      "method": "POST",
      "path": "/issue",
      "fields": [
        {
          "name": "projectKey",
          "label": {
            "es": "Clave del proyecto",
            "en": "Project key"
          },
          "placeholder": "OPS",
          "required": true,
          "lookup": {
            "path": "/project/search",
            "query": {
              "maxResults": "100"
            },
            "result": "values",
            "value": "key",
            "label": "{{key}} · {{name}}"
          }
        },
        {
          "name": "issueType",
          "label": {
            "es": "Tipo",
            "en": "Type"
          },
          "placeholder": "Task",
          "required": true,
          "lookup": {
            "path": "/project/{{projectKey}}",
            "result": "issueTypes",
            "value": "name",
            "label": "{{name}}",
            "needs": [
              "projectKey"
            ]
          }
        },
        {
          "name": "summary",
          "label": {
            "es": "Resumen",
            "en": "Summary"
          },
          "required": true
        },
        {
          "name": "description",
          "label": {
            "es": "Descripción",
            "en": "Description"
          },
          "multiline": true
        }
      ],
      "body": {
        "fields": {
          "project": {
            "key": "{{projectKey}}"
          },
          "issuetype": {
            "name": "{{issueType}}"
          },
          "summary": "{{summary}}",
          "description": {
            "$when": "description",
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "{{description}}"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "id": "search",
      "name": {
        "es": "Buscar issues (JQL)",
        "en": "Search issues (JQL)"
      },
      "method": "GET",
      "path": "/search/jql",
      "query": {
        "jql": "{{jql}}",
        "maxResults": "{{maxResults}}",
        "fields": "*navigable"
      },
      "fields": [
        {
          "name": "jql",
          "label": {
            "es": "JQL",
            "en": "JQL"
          },
          "placeholder": "project = OPS AND status = \"To Do\"",
          "required": true
        },
        {
          "name": "maxResults",
          "label": {
            "es": "Cuántos",
            "en": "How many"
          },
          "placeholder": "50"
        }
      ],
      "result": "issues"
    },
    {
      "id": "addComment",
      "name": {
        "es": "Comentar un issue",
        "en": "Comment on an issue"
      },
      "method": "POST",
      "path": "/issue/{{issueKey}}/comment",
      "fields": [
        {
          "name": "issueKey",
          "label": {
            "es": "Issue",
            "en": "Issue"
          },
          "placeholder": "OPS-12",
          "required": true,
          "lookup": {
            "path": "/search/jql",
            "query": {
              "jql": "updated >= -30d order by updated DESC",
              "maxResults": "50",
              "fields": "summary"
            },
            "result": "issues",
            "value": "key",
            "label": "{{key}} · {{fields.summary}}"
          }
        },
        {
          "name": "comment",
          "label": {
            "es": "Comentario",
            "en": "Comment"
          },
          "multiline": true,
          "required": true
        }
      ],
      "body": {
        "body": {
          "type": "doc",
          "version": 1,
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "{{comment}}"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "transition",
      "name": {
        "es": "Mover un issue de estado",
        "en": "Move an issue's status"
      },
      "method": "POST",
      "path": "/issue/{{issueKey}}/transitions",
      "fields": [
        {
          "name": "issueKey",
          "label": {
            "es": "Issue",
            "en": "Issue"
          },
          "placeholder": "OPS-42",
          "required": true
        },
        {
          "name": "transitionId",
          "label": {
            "es": "Transición",
            "en": "Transition"
          },
          "required": true,
          "lookup": {
            "path": "/issue/{{issueKey}}/transitions",
            "result": "transitions",
            "value": "id",
            "label": "{{name}} → {{to.name}}",
            "needs": [
              "issueKey"
            ]
          }
        }
      ],
      "body": {
        "transition": {
          "id": "{{transitionId}}"
        }
      }
    },
    {
      "id": "assign",
      "name": {
        "es": "Asignar un issue",
        "en": "Assign an issue"
      },
      "method": "PUT",
      "path": "/issue/{{issueKey}}/assignee",
      "fields": [
        {
          "name": "issueKey",
          "label": {
            "es": "Issue",
            "en": "Issue"
          },
          "placeholder": "OPS-42",
          "required": true
        },
        {
          "name": "accountId",
          "label": {
            "es": "Persona (accountId)",
            "en": "Person (accountId)"
          },
          "required": true,
          "lookup": {
            "path": "/user/assignable/search",
            "query": {
              "issueKey": "{{issueKey}}",
              "maxResults": "100"
            },
            "value": "accountId",
            "label": "{{displayName}} · {{emailAddress}}",
            "needs": [
              "issueKey"
            ]
          }
        }
      ],
      "body": {
        "accountId": "{{accountId}}"
      }
    },
    {
      "id": "getIssue",
      "name": {
        "es": "Leer un issue",
        "en": "Read an issue"
      },
      "method": "GET",
      "path": "/issue/{{issueKey}}",
      "fields": [
        {
          "name": "issueKey",
          "label": {
            "es": "Issue",
            "en": "Issue"
          },
          "placeholder": "OPS-42",
          "required": true
        }
      ]
    }
  ]
}
