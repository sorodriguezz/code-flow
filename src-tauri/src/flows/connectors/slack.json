{
  "id": "slack",
  "name": "Slack",
  "group": "appsChat",
  "baseUrl": "https://slack.com/api",
  "auth": "bearer",
  "authHint": {
    "es": "Token de bot (xoxb-…) como credencial Bearer",
    "en": "Bot token (xoxb-…) as a Bearer credential"
  },
  "tokenUrl": "https://api.slack.com/apps",
  "test": {
    "path": "/auth.test",
    "label": "{{user}} · {{team}}"
  },
  "okField": "ok",
  "errorField": "error",
  "operations": [
    {
      "id": "postMessage",
      "name": {
        "es": "Enviar un mensaje",
        "en": "Send a message"
      },
      "method": "POST",
      "path": "/chat.postMessage",
      "fields": [
        {
          "name": "channel",
          "label": {
            "es": "Canal",
            "en": "Channel"
          },
          "placeholder": "#general",
          "required": true,
          "lookup": {
            "path": "/conversations.list",
            "query": {
              "types": "public_channel",
              "exclude_archived": "true",
              "limit": "200"
            },
            "result": "channels",
            "value": "id",
            "label": "#{{name}}"
          }
        },
        {
          "name": "text",
          "label": {
            "es": "Mensaje",
            "en": "Message"
          },
          "multiline": true,
          "required": true
        },
        {
          "name": "thread_ts",
          "label": {
            "es": "Responder en el hilo (ts)",
            "en": "Reply in thread (ts)"
          }
        }
      ],
      "body": {
        "channel": "{{channel}}",
        "text": "{{text}}",
        "thread_ts": "{{thread_ts}}"
      }
    },
    {
      "id": "listChannels",
      "name": {
        "es": "Listar canales",
        "en": "List channels"
      },
      "method": "GET",
      "path": "/conversations.list",
      "query": {
        "limit": "200",
        "exclude_archived": "true"
      },
      "fields": [],
      "result": "channels"
    },
    {
      "id": "history",
      "name": {
        "es": "Leer mensajes de un canal",
        "en": "Read a channel's messages"
      },
      "method": "GET",
      "path": "/conversations.history",
      "query": {
        "channel": "{{channel}}",
        "limit": "{{limit}}"
      },
      "fields": [
        {
          "name": "channel",
          "label": {
            "es": "ID del canal",
            "en": "Channel ID"
          },
          "placeholder": "C0123456",
          "required": true,
          "lookup": {
            "path": "/conversations.list",
            "query": {
              "types": "public_channel",
              "exclude_archived": "true",
              "limit": "200"
            },
            "result": "channels",
            "value": "id",
            "label": "#{{name}}"
          }
        },
        {
          "name": "limit",
          "label": {
            "es": "Cuántos",
            "en": "How many"
          },
          "placeholder": "50"
        }
      ],
      "result": "messages"
    },
    {
      "id": "updateMessage",
      "name": {
        "es": "Editar un mensaje",
        "en": "Edit a message"
      },
      "method": "POST",
      "path": "/chat.update",
      "fields": [
        {
          "name": "channel",
          "label": {
            "es": "Canal (id)",
            "en": "Channel (id)"
          },
          "required": true
        },
        {
          "name": "ts",
          "label": {
            "es": "Mensaje (ts)",
            "en": "Message (ts)"
          },
          "required": true
        },
        {
          "name": "text",
          "label": {
            "es": "Texto nuevo",
            "en": "New text"
          },
          "multiline": true,
          "required": true
        }
      ],
      "body": {
        "channel": "{{channel}}",
        "ts": "{{ts}}",
        "text": "{{text}}"
      }
    },
    {
      "id": "addReaction",
      "name": {
        "es": "Reaccionar a un mensaje",
        "en": "React to a message"
      },
      "method": "POST",
      "path": "/reactions.add",
      "fields": [
        {
          "name": "channel",
          "label": {
            "es": "Canal (id)",
            "en": "Channel (id)"
          },
          "required": true
        },
        {
          "name": "timestamp",
          "label": {
            "es": "Mensaje (ts)",
            "en": "Message (ts)"
          },
          "required": true
        },
        {
          "name": "name",
          "label": {
            "es": "Emoji (sin dos puntos)",
            "en": "Emoji (no colons)"
          },
          "required": true,
          "placeholder": "white_check_mark"
        }
      ],
      "body": {
        "channel": "{{channel}}",
        "timestamp": "{{timestamp}}",
        "name": "{{name}}"
      }
    },
    {
      "id": "lookupUser",
      "name": {
        "es": "Buscar a una persona por correo",
        "en": "Find a person by email"
      },
      "method": "GET",
      "path": "/users.lookupByEmail",
      "query": {
        "email": "{{email}}"
      },
      "fields": [
        {
          "name": "email",
          "label": {
            "es": "Correo",
            "en": "Email"
          },
          "required": true
        }
      ],
      "result": "user"
    },
    {
      "id": "setTopic",
      "name": {
        "es": "Cambiar el tema de un canal",
        "en": "Set a channel's topic"
      },
      "method": "POST",
      "path": "/conversations.setTopic",
      "fields": [
        {
          "name": "channel",
          "label": {
            "es": "Canal (id)",
            "en": "Channel (id)"
          },
          "required": true
        },
        {
          "name": "topic",
          "label": {
            "es": "Tema",
            "en": "Topic"
          },
          "required": true
        }
      ],
      "body": {
        "channel": "{{channel}}",
        "topic": "{{topic}}"
      },
      "result": "channel"
    }
  ]
}
