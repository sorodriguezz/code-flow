{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeFlow",
  "version": "../package.json",
  "identifier": "com.codeflow.app",
  "build": {
    "beforeDevCommand": "pnpm iris:runtime:dev && pnpm llama:runtime:dev && pnpm drawio:webapp:dev && pnpm build:mobile && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm drawio:webapp && pnpm build && pnpm build:mobile && pnpm iris:runtime && pnpm llama:runtime",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sorodriguezz/code-flow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzOENDNzYzN0MwMDg3MkUKUldRdWh3QjhZOGVNUTN2aDJ6aHRkRVhyL0JkVjdEMjlpekVUdXJWWU9RNUltbzAvZmdmMUlqMWEK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/iris/": "iris/",
      "resources/mobile/": "mobile/",
      "resources/llama/": "llama/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
